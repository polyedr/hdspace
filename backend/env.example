# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=adevi_db
DB_USER=adevi_user
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email Settings
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@adevi.io

# AWS SES (if using)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=ap-southeast-2

# Stripe (Payment Processing)
STRIPE_API_SECRET=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Social Auth - Google
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth-key
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth-secret

# Social Auth - Facebook
SOCIAL_AUTH_FACEBOOK_KEY=your-facebook-key
SOCIAL_AUTH_FACEBOOK_SECRET=your-facebook-secret

# Social Auth - LinkedIn
SOCIAL_AUTH_LINKEDIN_KEY=your-linkedin-key
SOCIAL_AUTH_LINKEDIN_SECRET=your-linkedin-secret

# Stream Chat
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# Application URLs
BASE_URL=http://localhost:8000
DOMAIN=localhost
STAGING_URL=http://localhost:8000

# Debug Toolbar
ENABLE_DEBUG_TOOLBAR=False
INTERNAL_IPS=127.0.0.1,localhost

# Docker
WEB_PORT=8000

# Superuser (для автоматического создания в dev режиме)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@adevi.io
DJANGO_SUPERUSER_PASSWORD=changeme123

