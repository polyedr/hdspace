{
  "allowSyntheticDefaultImports": true,
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react",
    "lib": [ "es2020", "dom", "scripthost"],
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "$components/*": [ "src/components/*" ],
      "$containers/*": [ "src/containers/*" ],
      "$features/*": [ "src/features/*" ],
      "$constants/*": [ "src/constants/*" ],
      "$assets/*": [ "src/assets/*" ],
      "$config/*": [ "./config/*" ],
      "$styles/*": [ "src/styles/*" ],
      "$redux/*": [ "src/redux/*" ],
      "$utils/*": [ "src/utils/*" ],
      "$api/*": [ "src/api/*" ],
      "$test/*": [ "./test/*" ],
      "$shared/*": [ "src/shared/*" ],
    }
  },
  "include": [
    //"./src/index.tsx",
    "src/**/*"
    // "./src/**/*",
  ]
}
