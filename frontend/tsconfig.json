{
  "allowSyntheticDefaultImports": true,
  "compilerOptions": {
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react",
    "lib": ["esnext", "dom", "scripthost", "dom.iterable"],
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@Components/*": ["src/components/*"],
      "@Constants/*": ["src/constants/*"],
      "@Utils/*": ["src/utils/*"],
      "@Redux/*": ["src/redux/*"],
      "@Api/*": ["src/api/*"],
      "@Domain/*": ["src/domain/*"],
      "@Src/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/__tests__/**"]
}
