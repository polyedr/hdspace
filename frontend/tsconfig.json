{
  "allowSyntheticDefaultImports": true,
  "compilerOptions": {
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react",
    "lib": [ "es2020", "dom", "scripthost"],
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "baseUrl": "."
  },
  "include": [
    //"./src/index.tsx",
    "src/**/*"
    // "./src/**/*",
  ],
  "exclude": ["node_modules", "**/__tests__/**"]
}
